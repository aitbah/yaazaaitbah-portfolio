{
  "name": "@portfolio/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skill-icons": {
      "types": "./dist/skill-icons.data.d.ts",
      "default": "./dist/skill-icons.data.js"
    },
    "./option-seed": {
      "types": "./dist/option-seed.data.d.ts",
      "default": "./dist/option-seed.data.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.5.2"
  }
}
