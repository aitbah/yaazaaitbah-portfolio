# The edge, for a VPS whose own Caddy already owns 80 and 443.
#
# `scripts/Caddyfile` is the same site written for the bundled `proxy` service.
# Two processes cannot both bind the public ports, so a machine that already
# serves other names keeps its Caddy and takes this file instead. The stack then publishes the app on the loopback interface only,
# which is what the `ports:` entries in `docker-compose.prod.yml` do.
#
# Installed as an import of the host's Caddyfile:
#
#   sudo install -m 644 scripts/Caddyfile.host /etc/caddy/Caddyfile.d/portfolio.caddy
#   grep -q Caddyfile.d /etc/caddy/Caddyfile || \
#     echo 'import /etc/caddy/Caddyfile.d/*.caddy' | sudo tee -a /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

# The visitor's address, as the app should see it.
#
# Every request here comes through Cloudflare, so the connecting address is
# Cloudflare's, and a backend handed that would give everyone on the same edge
# one shared login allowance and one shared contact-form allowance.
# `CF-Connecting-IP` is believed only from Cloudflare's published ranges
# (cloudflare.com/ips); from anywhere else it is a header anyone can type, and
# the connecting address stands.
#
# A snippet rather than the global `trusted_proxies`: this file is appended
# after the host's own sites, where a global options block is not allowed.
(cloudflare_ranges) {
	remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

(client_address) {
	@via_cloudflare {
		import cloudflare_ranges
	}
	@direct {
		not {
			import cloudflare_ranges
		}
	}

	# Two matchers that cannot both be true, rather than a default and an
	# override: Caddy runs a directive with no matcher after the same directive
	# with one, so a default written first would still be applied last.
	request_header @direct X-Client-Address {http.request.remote.host}
	request_header @via_cloudflare X-Client-Address {http.request.header.CF-Connecting-IP}
}

# Both hosts front the same two containers, and hand each the visitor's own
# address as the single `X-Forwarded-For` hop that `TRUST_PROXY=1` believes.
(portfolio_upstreams) {
	import client_address

	handle /uploads/* {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:5000} {
			header_up X-Forwarded-For {http.request.header.X-Client-Address}
		}
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT:5000} {
			header_up X-Forwarded-For {http.request.header.X-Client-Address}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {http.request.header.X-Client-Address}
		}
	}
}

{$SITE_DOMAIN} {
	tls {$ACME_EMAIL}
	encode zstd gzip

	# One canonical origin for the admin, so the session cookie has one home -
	# and so the inbox link in a notification mail lands there too. The address
	# is public either way: this is tidiness and SEO, not a lock.
	@admin path_regexp ^/[a-z]{2}/admin(/|$)
	redir @admin https://{$ADMIN_DOMAIN}{uri} permanent

	import portfolio_upstreams
}

# The admin, on its own host so that its cookie is first-party there and the
# public site never carries one. The browser bundle addresses the API by path
# rather than by origin, which is what makes one build serve both names.
{$ADMIN_DOMAIN} {
	tls {$ACME_EMAIL}
	encode zstd gzip

	header X-Robots-Tag "noindex, nofollow"

	redir / /en/admin permanent

	import portfolio_upstreams
}

www.{$SITE_DOMAIN} {
	tls {$ACME_EMAIL}
	redir https://{$SITE_DOMAIN}{uri} permanent
}
