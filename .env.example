# Copy to .env and fill in real values. Never commit .env.

# Points to the `mongo` service on the Docker network, not localhost
MONGO_URI=
BACKEND_PORT=
FRONTEND_URL=
# 32 characters minimum
JWT_SECRET=
# Backend URL as the browser sees it - the frontend calls it from the client,
# so it must be reachable from the host, not the Docker service name
NEXT_PUBLIC_API_URL=
# The site's own public origin - canonical URLs, hreflang and the sitemap
NEXT_PUBLIC_SITE_URL=

# Optional - defaults: development / info / uploads
NODE_ENV=
LOG_LEVEL=
# Where uploaded images are written, relative to the backend working directory
UPLOADS_DIR=
# Reverse proxies in front of the backend; 0 (the default) with none
TRUST_PROXY=

# Optional - opening the development site from a phone on the home network.
# The address the frontend is published on: 127.0.0.1 (the default) keeps it to
# this machine; 0.0.0.0 opens it to the network too, and localhost still works.
FRONTEND_BIND=
# Hosts besides localhost allowed to load the dev server's scripts, comma-
# separated - this machine's address on the network, e.g. 192.168.1.20
DEV_HOSTS=

# Mail - optional, and all-or-nothing.
#
# Leave every line blank and the site works exactly as it does now: nothing is
# sent, and the backend says so once at startup. Fill them in and the owner is
# emailed whenever someone uses the contact form.
#
# Set any one of these four and the other three become required, because a
# half-configured transport looks enabled and fails on the one message that
# mattered. The backend refuses to start rather than find out later.
#
# Once set, /admin/account shows what is configured and offers a test send.
# The values are read there and never editable: a password kept in the database
# can be read back out of it, and out of every backup.
SMTP_HOST=
# 465 is TLS from the first byte; 587 negotiates with STARTTLS.
SMTP_PORT=
SMTP_FROM=
# Where notifications go. Not necessarily the address that signs in.
CONTACT_NOTIFY_TO=
# Optional, and only as a pair. A relay on a private network may need neither.
SMTP_USER=
SMTP_PASSWORD=
