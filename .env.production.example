# Copy to .env.production on the server and fill in real values.
# Never commit .env.production, and never copy the development .env to a server.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- The host ---------------------------------------------------------------
# The domains Caddy obtains certificates for. Names, no scheme. The admin is a
# host of its own so its session cookie is first-party there and the public site
# never carries one; both are the same build.
SITE_DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- Database ---------------------------------------------------------------
# Generate both: openssl rand -base64 30
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=portfolio
# The least-privilege user the application connects as: readWrite on its own
# database and nothing else. Created once, on first boot, by
# scripts/mongo-init-user.js.
MONGO_APP_USERNAME=portfolio
MONGO_APP_PASSWORD=

# Must match the three values above. `authSource` is the database the user was
# created in, which is the application's own - not `admin`.
MONGO_URI=mongodb://portfolio:REPLACE_WITH_MONGO_APP_PASSWORD@mongo:27017/portfolio?authSource=portfolio

# --- Application ------------------------------------------------------------
BACKEND_PORT=5000

# A fresh one for production. Never the development value:
#   openssl rand -base64 48
JWT_SECRET=

# The public origin. Caddy serves the site and the API on one host, so the
# browser addresses the API by path - `same-origin` is the literal that says so,
# and it is what lets one build also serve the admin on its own subdomain with a
# first-party session cookie. `NEXT_PUBLIC_*` are baked into the browser bundle
# at build time, so changing one means rebuilding the frontend image.
FRONTEND_URL=https://example.com
NEXT_PUBLIC_API_URL=same-origin
NEXT_PUBLIC_SITE_URL=https://example.com

LOG_LEVEL=info

# --- Mail (optional, all-or-nothing) ----------------------------------------
# Set any one of the first four and the rest become required. See .env.example.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
CONTACT_NOTIFY_TO=
SMTP_USER=
SMTP_PASSWORD=
